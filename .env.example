# Copy to .env.local and fill in.
# Both are server-side only — never prefix these with NEXT_PUBLIC_.

# The webhook URL Make gives you when you add a Custom Webhook trigger.
MAKE_WEBHOOK_URL=

# Any long random string. Generate one with:  openssl rand -hex 32
# The Make scenario checks this so nobody else can post into your Drive.
MAKE_WEBHOOK_SECRET=
